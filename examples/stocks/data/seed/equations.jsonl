{"name": "DAILY_RETURN_PCT", "type": "column", "description": "Daily return as percentage, computed from open to close", "keywords": "return,daily,percent,percentage,gain,loss,intraday", "rule": {"expression": "(close - open) / open * 100", "required_columns": ["open", "close"]}}
{"name": "SPREAD", "type": "column", "description": "Intraday price spread (high minus low)", "keywords": "spread,range,volatility,high,low,intraday", "rule": {"expression": "high - low", "required_columns": ["high", "low"]}}
{"name": "SPREAD_PCT", "type": "column", "description": "Intraday spread as percentage of open", "keywords": "spread,range,percent,volatility", "rule": {"expression": "(high - low) / open * 100", "required_columns": ["high", "low", "open"]}}
{"name": "MIDPOINT", "type": "column", "description": "Midpoint between high and low", "keywords": "midpoint,average,middle,center", "rule": {"expression": "(high + low) / 2", "required_columns": ["high", "low"]}}
{"name": "TYPICAL_PRICE", "type": "column", "description": "Typical price: average of high, low, close", "keywords": "typical,price,average,hlc", "rule": {"expression": "(high + low + close) / 3", "required_columns": ["high", "low", "close"]}}
{"name": "CLOSE_CHANGE", "type": "column", "description": "Change in close price (requires prev_close column)", "keywords": "change,delta,difference,close", "rule": {"expression": "close - prev_close", "required_columns": ["close", "prev_close"]}}
{"name": "CLOSE_CHANGE_PCT", "type": "column", "description": "Percent change in close price (requires prev_close column)", "keywords": "change,percent,return,close,daily", "rule": {"expression": "(close - prev_close) / prev_close * 100", "required_columns": ["close", "prev_close"]}}
{"name": "MOVING_AVERAGE", "type": "window", "description": "Simple moving average over specified window", "keywords": "moving,average,sma,ma,rolling,mean,trend", "rule": {"pattern": "rolling", "function": "mean", "parameters": [{"name": "column", "type": "column_name", "required": true}, {"name": "window", "type": "integer", "required": true, "default": 20}]}}
{"name": "ROLLING_STD", "type": "window", "description": "Rolling standard deviation over specified window", "keywords": "rolling,std,standard,deviation,volatility,sigma,risk", "rule": {"pattern": "rolling", "function": "std", "parameters": [{"name": "column", "type": "column_name", "required": true}, {"name": "window", "type": "integer", "required": true, "default": 20}]}}
{"name": "ROLLING_MIN", "type": "window", "description": "Rolling minimum over specified window", "keywords": "rolling,min,minimum,low,floor,support", "rule": {"pattern": "rolling", "function": "min", "parameters": [{"name": "column", "type": "column_name", "required": true}, {"name": "window", "type": "integer", "required": true}]}}
{"name": "ROLLING_MAX", "type": "window", "description": "Rolling maximum over specified window", "keywords": "rolling,max,maximum,high,ceiling,peak,resistance", "rule": {"pattern": "rolling", "function": "max", "parameters": [{"name": "column", "type": "column_name", "required": true}, {"name": "window", "type": "integer", "required": true}]}}
{"name": "LAG", "type": "window", "description": "Previous value (shifted forward by N periods)", "keywords": "lag,previous,prior,shift,yesterday,before", "rule": {"pattern": "shift", "parameters": [{"name": "column", "type": "column_name", "required": true}, {"name": "n", "type": "integer", "required": false, "default": 1}]}}
{"name": "PERCENT_CHANGE", "type": "window", "description": "Percent change from N periods ago", "keywords": "percent,change,growth,return,pct,delta,momentum", "rule": {"pattern": "pct_change", "parameters": [{"name": "column", "type": "column_name", "required": true}, {"name": "n", "type": "integer", "required": false, "default": 1}]}}
{"name": "CUMULATIVE_SUM", "type": "window", "description": "Running total of specified column", "keywords": "cumulative,running,total,sum,cumsum", "rule": {"pattern": "cumulative", "function": "sum", "parameters": [{"name": "column", "type": "column_name", "required": true}]}}
{"name": "CUMULATIVE_MAX", "type": "window", "description": "Running maximum (high water mark)", "keywords": "cumulative,max,maximum,high,water,mark,peak,ath", "rule": {"pattern": "cumulative", "function": "cummax", "parameters": [{"name": "column", "type": "column_name", "required": true}]}}
{"name": "WEIGHTED_AVERAGE", "type": "aggregate", "description": "Weighted average: sum(value * weight) / sum(weight)", "keywords": "weighted,average,mean,vwap,market,cap", "rule": {"formula": "sum({value_column} * {weight_column}) / sum({weight_column})", "parameters": [{"name": "value_column", "type": "column_name", "required": true}, {"name": "weight_column", "type": "column_name", "required": true}]}}
{"name": "ANNUALIZED_VOLATILITY", "type": "aggregate", "description": "Annualized volatility (std * sqrt(252))", "keywords": "volatility,vol,risk,std,sigma,annualized,annual", "rule": {"formula": "std({return_column}) * 15.87", "parameters": [{"name": "return_column", "type": "column_name", "required": true, "description": "Daily return column"}]}}
{"name": "SHARPE_RATIO", "type": "builtin", "description": "Sharpe ratio: (mean return - risk_free) / std return", "keywords": "sharpe,ratio,risk,adjusted,return,performance", "rule": {"function_name": "compute_sharpe_ratio", "parameters": [{"name": "return_column", "type": "column_name", "required": true}, {"name": "risk_free_rate", "type": "float", "required": false, "default": 0.0}]}}
{"name": "MAX_DRAWDOWN", "type": "builtin", "description": "Maximum drawdown from peak", "keywords": "drawdown,max,dd,mdd,loss,decline,peak,trough", "rule": {"function_name": "compute_max_drawdown", "parameters": [{"name": "price_column", "type": "column_name", "required": true}]}}
{"name": "GAP_PCT", "type": "column", "description": "Overnight gap: percent difference between open and previous close", "keywords": "gap,overnight,open,jump,drop,surprise", "rule": {"expression": "(open - prev_close) / prev_close * 100", "required_columns": ["open", "prev_close"]}}
{"name": "CLOSE_POSITION", "type": "column", "description": "Where close landed in day's range (0=low, 100=high)", "keywords": "close,position,range,candle,body", "rule": {"expression": "(close - low) / (high - low) * 100", "required_columns": ["close", "high", "low"]}}
{"name": "BODY_SIZE_PCT", "type": "column", "description": "Candle body size as percent of day's range", "keywords": "body,candle,range,size,doji", "rule": {"expression": "abs(close - open) / (high - low) * 100", "required_columns": ["open", "close", "high", "low"]}}
{"name": "TRUE_RANGE", "type": "column", "description": "True range: max of (high-low, |high-prev_close|, |low-prev_close|)", "keywords": "true,range,atr,volatility,tr", "rule": {"expression": "max(high - low, abs(high - prev_close), abs(low - prev_close))", "required_columns": ["high", "low", "prev_close"]}}
{"name": "VWAP", "type": "builtin", "description": "Cumulative volume-weighted average price: cumsum((high+low+close)/3 * volume) / cumsum(volume). Requires high, low, close, volume columns (auto-detected by default; specify high_column/low_column/volume_column if your view uses different names). Use partition_by=['ticker'] for per-stock reset.", "keywords": "vwap,volume,weighted,average,price,institutional,cumulative", "rule": {"function_name": "compute_indicator", "indicator": "vwap", "parameters": [{"name": "high_column", "type": "column_name", "required": false, "default": "auto-detected"}, {"name": "low_column", "type": "column_name", "required": false, "default": "auto-detected"}, {"name": "volume_column", "type": "column_name", "required": false, "default": "auto-detected"}, {"name": "partition_by", "type": "array", "required": false, "description": "Columns to reset cumulation per group (e.g., ['ticker'])"}], "required_columns": ["high", "low", "close", "volume"]}}
{"name": "EMA", "type": "window", "description": "Exponential moving average over specified span", "keywords": "ema,exponential,moving,average,trend,weighted", "rule": {"pattern": "ewm", "function": "mean", "parameters": [{"name": "column", "type": "column_name", "required": true}, {"name": "span", "type": "integer", "required": true, "default": 20}]}}
{"name": "ROLLING_SUM", "type": "window", "description": "Rolling sum over specified window", "keywords": "rolling,sum,total,cumulative,window", "rule": {"pattern": "rolling", "function": "sum", "parameters": [{"name": "column", "type": "column_name", "required": true}, {"name": "window", "type": "integer", "required": true}]}}
{"name": "N_DAY_HIGH", "type": "window", "description": "Highest high over N days (e.g., 252 for 52-week high)", "keywords": "high,52week,yearly,peak,resistance,alltime,ath", "rule": {"pattern": "rolling", "function": "max", "parameters": [{"name": "column", "type": "column_name", "required": true, "default": "high"}, {"name": "window", "type": "integer", "required": true, "default": 252}]}}
{"name": "N_DAY_LOW", "type": "window", "description": "Lowest low over N days (e.g., 252 for 52-week low)", "keywords": "low,52week,yearly,trough,support,floor", "rule": {"pattern": "rolling", "function": "min", "parameters": [{"name": "column", "type": "column_name", "required": true, "default": "low"}, {"name": "window", "type": "integer", "required": true, "default": 252}]}}
{"name": "RSI", "type": "builtin", "description": "Relative Strength Index (0-100). Above 70 = overbought, below 30 = oversold", "keywords": "rsi,relative,strength,index,overbought,oversold,momentum,oscillator", "rule": {"function_name": "compute_rsi", "parameters": [{"name": "price_column", "type": "column_name", "required": true, "default": "close"}, {"name": "period", "type": "integer", "required": false, "default": 14}]}}
{"name": "BOLLINGER_PCT_B", "type": "builtin", "description": "Bollinger %B: position within bands (0=lower, 1=upper, >1=above upper)", "keywords": "bollinger,bands,percent,b,pctb,overbought,oversold,squeeze", "rule": {"function_name": "compute_bollinger_pct_b", "parameters": [{"name": "price_column", "type": "column_name", "required": true, "default": "close"}, {"name": "period", "type": "integer", "required": false, "default": 20}, {"name": "std_dev", "type": "float", "required": false, "default": 2.0}]}}
{"name": "VOLUME_RATIO", "type": "builtin", "description": "Today's volume relative to N-day average (>1.5 = unusual activity)", "keywords": "volume,ratio,unusual,activity,surge,spike,relative", "rule": {"function_name": "compute_volume_ratio", "parameters": [{"name": "volume_column", "type": "column_name", "required": true, "default": "volume"}, {"name": "period", "type": "integer", "required": false, "default": 20}]}}
{"name": "DISTANCE_FROM_HIGH_PCT", "type": "builtin", "description": "Percent below N-day high (0 = at high, -20 = 20% below)", "keywords": "distance,high,52week,drawdown,below,peak,percent", "rule": {"function_name": "compute_distance_from_high", "parameters": [{"name": "price_column", "type": "column_name", "required": true, "default": "close"}, {"name": "high_column", "type": "column_name", "required": true, "default": "high"}, {"name": "period", "type": "integer", "required": false, "default": 252}]}}
{"name": "RELATIVE_PERFORMANCE", "type": "builtin", "description": "Cumulative excess return vs benchmark (positive = outperforming). Benchmarks: SPY, QQQ, IWM, DIA (use group='INDEX_ETF' to get all). Join stock with benchmark on date, then compute_indicator(relative_return).", "keywords": "relative,performance,benchmark,alpha,vs,spy,qqq,iwm,dia,outperform,underperform,excess,return,index,etf", "rule": {"function_name": "compute_indicator", "indicator": "relative_return", "parameters": [{"name": "column", "type": "column_name", "required": true, "description": "Stock return column"}, {"name": "benchmark_column", "type": "column_name", "required": true, "description": "Benchmark return column (e.g., spy_return)"}], "available_benchmarks": ["SPY", "QQQ", "IWM", "DIA"]}}
{"name": "MACD", "type": "builtin", "description": "MACD line (EMA12 - EMA26). Crossover signals trend changes.", "keywords": "macd,moving,average,convergence,divergence,trend,momentum,crossover,signal", "rule": {"function_name": "compute_indicator", "indicator": "macd", "parameters": [{"name": "column", "type": "column_name", "required": true, "default": "close"}]}}
{"name": "MACD_SIGNAL", "type": "builtin", "description": "MACD signal line (9-period EMA of MACD). Buy when MACD crosses above.", "keywords": "macd,signal,line,crossover,buy,sell,trigger", "rule": {"function_name": "compute_indicator", "indicator": "macd_signal", "parameters": [{"name": "column", "type": "column_name", "required": true, "default": "close"}]}}
{"name": "MACD_HISTOGRAM", "type": "builtin", "description": "MACD histogram (MACD - Signal). Positive = bullish momentum.", "keywords": "macd,histogram,momentum,divergence,bullish,bearish", "rule": {"function_name": "compute_indicator", "indicator": "macd_histogram", "parameters": [{"name": "column", "type": "column_name", "required": true, "default": "close"}]}}
{"name": "ATR", "type": "builtin", "description": "Average True Range - volatility indicator. Higher = more volatile.", "keywords": "atr,average,true,range,volatility,risk,stop,loss", "rule": {"function_name": "compute_indicator", "indicator": "atr", "parameters": [{"name": "period", "type": "integer", "required": false, "default": 14}]}}
